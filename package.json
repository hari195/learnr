{
  "name": "learnr",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:arc": "node scripts/build.mjs --target=arc",
    "typecheck": "tsc -b",
    "test": "vitest run",
