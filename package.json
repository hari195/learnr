    "verify:build:arc": "node scripts/verify-build.mjs --dir=dist-arc --target=arc"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.1",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
